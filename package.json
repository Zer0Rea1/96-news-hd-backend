{
  "name": "96-news-hd-api",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.3",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "db:migrate": "bun scripts/schema.ts",
    "build": "bun run typecheck && bun run db:migrate --apply"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.118.0",
    "cloudinary": "2.11.0",
    "cors": "2.8.6",
    "express": "5.3.0",
    "express-rate-limit": "8.7.3",
    "helmet": "8.3.0",
    "multer": "2.5.0",
    "sanitize-html": "2.18.1",
    "serverless-http": "4.0.0",
    "sharp": "0.35.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/bun": "1.4.4",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/multer": "2.3.0",
    "@types/pg": "8.23.1",
    "@types/sanitize-html": "2.16.2",
    "pg": "8.23.1",
    "typescript": "7.0.2"
  }
}
